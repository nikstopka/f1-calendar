# По умолчанию нормализуем переводы строк в LF, чтобы не было разнобоя
# между Windows и Linux при сборке на GitHub Actions.
* text=auto eol=lf

# ICS обязан оставаться в CRLF (RFC 5545). Любая конвертация переводов строк
# превратит файл в LF-only, и часть календарных приложений его не прочитает.
*.ics -text

# Бинарные файлы не трогать вообще.
*.png binary
*.ico binary
*.woff binary
*.woff2 binary